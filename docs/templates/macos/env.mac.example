# Copy to the project root as .env.local on the Mac, then replace this path.
# Use the actual Finder absolute path. $HOME and ~ are not expanded by the loader.
HEALTH_EXPORT_WATCH_DIR=/REPLACE/WITH/FINDER/HEALTH-AUTO-EXPORT/SLEEP
HEALTH_IMPORT_WATCH_ENABLED=true
HEALTH_IMPORT_STARTUP_SCAN_ENABLED=false
HEALTH_IMPORT_SERVER_PORT=8787
HEALTH_IMPORT_SCAN_INTERVAL_MS=300000
HEALTH_IMPORT_USE_POLLING=true
HEALTH_IMPORT_POLL_INTERVAL_MS=10000
HEALTH_IMPORT_AWAIT_WRITE_STABILITY_MS=5000
HEALTH_IMPORT_DATA_DIR=./server-data
PROCESSED_DATA_DIR=./processed-data
PROCESSED_DATA_BACKUP_DIR=
VITE_HEALTH_IMPORT_SERVER_URL=
# serve-production-web.mjs uses its own environment/defaults, not .env.local.
# These match its defaults; custom values must also be set in the Web LaunchAgent.
SLEEP_COMPASS_WEB_PORT=5180
SLEEP_COMPASS_WEB_DIST_DIR=./dist
