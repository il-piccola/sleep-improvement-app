# Set this to the OS-visible Health Auto Export Sleep directory on the host.
# Do not copy a drive letter or mount path from another machine.
HEALTH_EXPORT_WATCH_DIR=
HEALTH_IMPORT_WATCH_ENABLED=true
# Keep startup responsive by using the existing Processed Data snapshot.
# Set true only when a full initial Drive scan is intentionally required.
HEALTH_IMPORT_STARTUP_SCAN_ENABLED=false
HEALTH_IMPORT_SERVER_PORT=8787
# Leave blank for same-origin /api requests through the Vite local proxy.
VITE_HEALTH_IMPORT_SERVER_URL=
HEALTH_IMPORT_SCAN_INTERVAL_MS=300000
HEALTH_IMPORT_USE_POLLING=true
HEALTH_IMPORT_POLL_INTERVAL_MS=10000
HEALTH_IMPORT_AWAIT_WRITE_STABILITY_MS=5000

# Local runtime state. Keep outside HEALTH_EXPORT_WATCH_DIR.
HEALTH_IMPORT_DATA_DIR=./server-data

# Canonical immutable snapshots. Keep outside HEALTH_EXPORT_WATCH_DIR.
PROCESSED_DATA_DIR=./processed-data

# Optional completed-snapshot backup directory, for example an OS-visible Google Drive folder.
# Keep outside HEALTH_EXPORT_WATCH_DIR. Leave blank to disable backup.
PROCESSED_DATA_BACKUP_DIR=
